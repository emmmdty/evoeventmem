# Model gateway: any OpenAI-compatible endpoint may be used.
# Production (S2 v2 / S3 runs): the opencode.ai gateway served mimo-v2.5
#   for both reader and extractor roles. Set OPENAI_API_KEY to a real key.
# Offline repro (no network during the benchmark run itself): use
#   `provider = "deterministic_fake"` in configs/longmemeval/offline10.toml;
#   these OPENAI_* fields are then not read by the benchmark.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Reader / extractor role overrides (benchmarks/common/providers.py).
# Setting these env vars overrides the [reader]/[extractor] TOML sections.
# EEM_LLM_MODEL / EEM_LLM_API_KEY_ENV / EEM_LLM_BASE_URL apply to both chat
#   roles unless a role-specific EEM_READER_* / EEM_EXTRACTOR_* var is set.
EEM_LLM_MODEL=
EEM_LLM_API_KEY_ENV=
EEM_LLM_BASE_URL=

# Embedding service. Production (S2/S3): a local GPU tunnel serves
#   qwen3-embedding-0.6b on http://127.0.0.1:11436/v1; any non-empty
#   EMBEDDING_API_KEY value is accepted by the local server.
# Offline repro: deterministic_fake builds an in-memory embedding model and
#   makes zero network calls; these fields are not read in that mode.
EEM_EMBEDDING_BASE_URL=
EEM_EMBEDDING_MODEL=
EEM_EMBEDDING_DIMENSION=
EMBEDDING_API_KEY=

# Judge model for the S3 M2 stale-memory judge (minimax-m3 via the Ark API).
# The judge is intentionally NOT the reader/extractor model (mimo-v2.5):
#   AGENTS.md "LLM judges require cached inputs/outputs and a documented
#   judge model"; spec N8 / B4. M2 judge calls are cached to
#   <source-run>/m2_judge_cache/ (content-addressed). Not used by offline10.
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=

# Optional local endpoint, e.g. vLLM/SGLang/LM Studio/Ollama OpenAI compatibility.
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_OPENAI_API_KEY=local
LOCAL_CHAT_MODEL=
LOCAL_EMBEDDING_MODEL=

DATABASE_URL=postgresql+asyncpg://evoeventmem:evoeventmem@127.0.0.1:5432/evoeventmem
LOG_LEVEL=INFO

# API authentication. Comma-separated list of valid Bearer tokens.
# When unset or empty, auth middleware is disabled (development mode).
EEM_API_KEYS=your-api-key-here
